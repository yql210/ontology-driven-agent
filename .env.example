# OntoAgent 环境配置
# 复制本文件为 .env 并填入实际值：cp .env.example .env

# ---- Graph 后端选择 ----
# neo4j | nebula（生产推荐 nebula）
ONTOAGENT_GRAPH_BACKEND=nebula

# ---- NebulaGraph（graph_backend=nebula 时使用）----
ONTOAGENT_NEBULA_HOST=127.0.0.1
ONTOAGENT_NEBULA_PORT=9669
ONTOAGENT_NEBULA_USER=root
ONTOAGENT_NEBULA_PASSWORD=nebula
ONTOAGENT_NEBULA_SPACE=ontoagent

# ---- Neo4j（graph_backend=neo4j 时使用，已不推荐）----
# ONTOAGENT_NEO4J_URI=bolt://localhost:7687
# ONTOAGENT_NEO4J_USER=neo4j
# ONTOAGENT_NEO4J_PASSWORD=

# ---- Ollama（本地 LLM / Embedding）----
ONTOAGENT_OLLAMA_URL=http://localhost:11434
ONTOAGENT_EMBEDDING_MODEL=locusai/all-minilm-l6-v2
ONTOAGENT_LLM_MODEL=qwen3.5:9b

# ---- 语义提取 LLM（可选，替代 Ollama）----
# 提供商：ollama（默认）| openai
# ONTOAGENT_SEMANTIC_LLM_PROVIDER=openai
# OpenAI API Key（provider=openai 时必填）
# ONTOAGENT_SEMANTIC_API_KEY=sk-xxx
# OpenAI 兼容 API base URL
# ONTOAGENT_SEMANTIC_BASE_URL=https://api.openai.com/v1

# ---- ChromaDB ----
ONTOAGENT_CHROMA_DIR=.chroma

# ---- 构建选项 ----
# 是否包含文档文件（.md/.rst）
ONTOAGENT_BUILD_INCLUDE_DOCS=true
# 文档扩展名（逗号分隔）
# ONTOAGENT_BUILD_DOC_EXTENSIONS=.md,.rst
# 文档最大长度（字符数）
# ONTOAGENT_BUILD_DOC_MAX_LENGTH=2000
# 跳过的目录（逗号分隔）
# ONTOAGENT_BUILD_SKIP_DIRS=__pycache__,.git,.mypy_cache,.ruff_cache,.pytest_cache,node_modules,.venv,venv,site,.tox,dist,build,*.egg-info

# ---- Agent LLM（可选，用于 Agent 交互）----
ONTOAGENT_AGENT_LLM_PROVIDER=zhipu
ONTOAGENT_AGENT_LLM_MODEL=glm-4-flash
ONTOAGENT_AGENT_API_KEY=
ONTOAGENT_AGENT_BASE_URL=https://open.bigmodel.cn/api/anthropic

# ---- Web API 认证（生产推荐开启）----
# 设置后所有 /api 请求需带 Authorization: Bearer *** 或 X-API-Key: ***
# 留空则不启用认证
# ⚠️ 生产环境必须设置！生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
ONTOAGENT_API_KEY=

# ---- CORS（Web API 允许的前端来源）----
# 生产环境必须精确到域名，不要用 *
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 是否允许携带凭证（生产环境如需 Cookie 认证可开启）
CORS_ALLOW_CREDENTIALS=false

# ---- 限流（Rate Limiting）----
# 全局限流：每个 IP 每分钟最大请求数
ONTOAGENT_RATE_LIMIT=60/minute
# Chat 端点限流（LLM 调用成本高，需更严格限制）
ONTOAGENT_CHAT_RATE_LIMIT=10/minute
